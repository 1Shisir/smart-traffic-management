# Smart Traffic Management System - Environment Configuration
# Copy this file to .env and update the values for production use

# Flask Configuration
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=your_secret_key_here_change_in_production

# Database Configuration  
SQLALCHEMY_DATABASE_URI=sqlite:///traffic.db
SQLALCHEMY_ECHO=False

# JWT Configuration (IMPORTANT: Change in production!)
JWT_SECRET_KEY=your_jwt_secret_key_here_must_be_changed_in_production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=1

# Security Configuration
JWT_COOKIE_SECURE=False  # Set to True in production with HTTPS
CORS_ORIGINS=http://localhost:5173

# Video Processing Configuration
VIDEO_PATH=traffic_sample1.mp4
YOLO_MODEL=yolov8n.pt
DETECTION_THRESHOLD=0.5
TRAFFIC_LIGHT_THRESHOLD=12
FRAME_SKIP=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# User Credentials (Change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user  
USER_PASSWORD=user123

# Optional: Node-RED Integration
# NODE_RED_URL=http://localhost:1880/traffic-data
# NODE_RED_TIMEOUT=5
